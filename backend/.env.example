# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit the real connection string or secret.

# Atlas → Connect → Drivers. Replace USERNAME and PASSWORD.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@monobyte.mwzb913.mongodb.net/

# Database for app data (users + saved drugs). Created automatically on first sign up.
DB_NAME=monobyte

# Signs the login cookie. Any long random string; make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5001
NODE_ENV=development
