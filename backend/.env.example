# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit the real connection string or secret.

# Atlas → Connect → Drivers. Replace USERNAME and PASSWORD.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@monobyte.mwzb913.mongodb.net/

# Database for app data (users + saved drugs). Created automatically on first sign up.
DB_NAME=monobyte

# Signs the login cookie. Any long random string; make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=5001
NODE_ENV=development

# Where the frontend runs. Links in emails (password reset) point here.
APP_URL=http://localhost:5173

# Email (password-reset links). Optional locally: leave SMTP_HOST empty and the
# Forgot password page shows a "Demo only" link instead, and the server prints
# it. Required when NODE_ENV=production.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#   SMTP_PASS=an app password (Google Account → Security → App passwords,
#   needs 2-step verification). Your normal Gmail password won't work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox, e.g. MonoByte <you@gmail.com>. Gmail only allows
# its own address here. Defaults to SMTP_USER.
EMAIL_FROM=
